{
    "plugins": ["prettier-plugin-go-template"],
    "tabWidth": 4,
    "overrides": [
        {
            "files": ["*.html"],
            "options": {
                "parser": "go-template",
                "goTemplateBracketSpacing": true,
                "bracketSameLine": true
            }
        },
        {
            "files": ["*.js", "*.ts", "*.tsx"],
            "options": {
                "useTabs": true,
                "printWidth": 120,
                "singleQuote": true
            }
        },
        {
            "files": ["*.scss", "*.css"],
            "options": {
                "tabWidth": 4,
                "singleQuote": false
            }
        },
        {
            "files": ["*.json", "*.jsonc", "*.yaml", "*.yml", "*.toml"],
            "excludeFiles": ["layouts/**"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
